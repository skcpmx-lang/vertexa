<Window x:Class="Merqo.Vertexa.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Merqo.Vertexa.App.ViewModels"
        xmlns:views="clr-namespace:Merqo.Vertexa.App.Views"
        Title="MERQO VERTEXA" Height="900" Width="1460" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface0Brush}"
        Icon="/Assets/MerqoVertexa.png" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MetricPageViewModel}"><views:MetricPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}"><views:StorageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatteryViewModel}"><views:BatteryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}"><views:DriversView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}"><views:MonitorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><views:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisplayLabViewModel}"><views:DisplayLabView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardLabViewModel}"><views:KeyboardLabView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioLabViewModel}"><views:AudioLabView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <TextBlock Text="MERQO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="VERTEXA" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="PC &amp; laptop diagnostics" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding ElevationLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding MachineLabel}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="6,0,6,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource MicroLabel}" Margin="12,12,0,4" />
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource NavButton}" Content="{Binding Title}" Tag="{Binding Glyph}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Search  (Ctrl+K)" Style="{StaticResource SecondaryButton}" Command="{Binding TogglePaletteCommand}" Margin="0,0,8,0" />
                        <Button Content="Theme" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelScanCommand}" Margin="0,0,8,0" />
                        <Button Content="Quick scan" Style="{StaticResource SecondaryButton}" Command="{Binding QuickScanCommand}" Margin="0,0,8,0" />
                        <Button Content="Full scan" Style="{StaticResource PrimaryButton}" Command="{Binding FullScanCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" Margin="0" />
                <Border Background="{DynamicResource Surface0Brush}" Opacity="0.6"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Scanning…" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="22,8">
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Command palette -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
                Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                    CornerRadius="12" Width="560" Height="440" VerticalAlignment="Top" Margin="0,110,0,0" Padding="16">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="PaletteInput" FontSize="15" Padding="10,8"
                             Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="PaletteInput_KeyDown" />
                    <TextBlock DockPanel.Dock="Bottom" Text="Enter to open the first result · Esc to close" Style="{StaticResource MicroLabel}" Margin="2,8,0,0" />
                    <ListBox ItemsSource="{Binding PaletteResults}" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" MouseDoubleClick="PaletteList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Group}" Style="{StaticResource MicroLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
