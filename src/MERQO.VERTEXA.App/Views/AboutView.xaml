<UserControl x:Class="Merqo.Vertexa.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/MerqoVertexa.png" Width="84" Height="84" VerticalAlignment="Top" />
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Brand}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource MonoValue}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Build}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Platform}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Copyright}" Style="{StaticResource MicroLabel}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Contact and owner" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                        <Run Text="Founder: " /><Run Text="{Binding Founder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                        <Run Text="Email: " /><Run Text="{Binding Contact, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Licence" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding LicenceSummary}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UnsignedNotice}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding PrivacySummary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DataLocation}" Style="{StaticResource MicroLabel}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Third-party notices" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding ThirdPartyNotices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
