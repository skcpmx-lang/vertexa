<UserControl x:Class="Merqo.Vertexa.App.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="HEALTH" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource MonoValue}" FontSize="24" />
                        <TextBlock Text="{Binding Band}" Style="{StaticResource Caption}" />
                        <ProgressBar Value="{Binding HealthBar}" Maximum="100" Height="6" Margin="0,8,0,0"
                                     Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource Surface3Brush}" BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="WEAR" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding WearText}" Style="{StaticResource MonoValue}" FontSize="24" />
                        <TextBlock Text="(design − full charge) ÷ design" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CHARGE" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding ChargeText}" Style="{StaticResource MonoValue}" FontSize="24" />
                        <TextBlock Text="{Binding PowerSource}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RUNTIME (ESTIMATE)" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource MonoValue}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CycleCountText, StringFormat=Cycles: {0}}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Wear is only calculated when the firmware reports both design and full-charge capacity. Runtime is an estimate derived from the observed discharge rate, not a promise." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Rows}" Style="{StaticResource MetricGrid}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
