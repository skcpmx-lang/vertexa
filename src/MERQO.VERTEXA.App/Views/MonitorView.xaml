<UserControl x:Class="Merqo.Vertexa.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Merqo.Vertexa.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCommand}" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="Interval: " /><Run Text="{Binding IntervalText, Mode=OneWay}" /><Run Text=" · " />
                        <Run Text="{Binding SampleText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CPU UTILISATION" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding CpuDisplay}" Style="{StaticResource MonoValue}" FontSize="20" />
                        <ctrl:Sparkline Values="{Binding CpuSeries}" Height="90" Margin="0,8,0,0" Stroke="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MEMORY IN USE" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding MemoryDisplay}" Style="{StaticResource MonoValue}" FontSize="20" />
                        <ctrl:Sparkline Values="{Binding MemorySeries}" Height="90" Margin="0,8,0,0" Stroke="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="TEMPERATURE" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding TemperatureDisplay}" Style="{StaticResource MonoValue}" FontSize="18" />
                        <ctrl:Sparkline Values="{Binding TemperatureSeries}" Height="60" Maximum="110" Margin="0,6,0,0" Stroke="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="DISK THROUGHPUT" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding DiskDisplay}" Style="{StaticResource MonoValue}" FontSize="18" />
                        <ctrl:Sparkline Values="{Binding DiskSeries}" Height="60" Maximum="500000000" Margin="0,6,0,0" Stroke="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="NETWORK THROUGHPUT" Style="{StaticResource MicroLabel}" />
                        <TextBlock Text="{Binding NetworkDisplay}" Style="{StaticResource MonoValue}" FontSize="18" />
                        <ctrl:Sparkline Values="{Binding NetworkSeries}" Height="60" Maximum="500000000" Margin="0,6,0,0" Stroke="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="What is not available here" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding UnavailableText}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Gaps in the charts are real gaps: a metric the platform does not expose is never drawn as a zero line." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
