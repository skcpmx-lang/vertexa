<UserControl x:Class="Merqo.Vertexa.App.Views.KeyboardLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacy and scope" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="Keys are captured only while this page has keyboard focus. Nothing is logged to disk, and the capture stops as soon as you navigate away." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Layout:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" Width="140" Margin="0,0,12,0" />
                        <Button Content="Reset" Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding LastKey, StringFormat=Last key: {0}}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding RolloverText}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding PendingText}" Style="{StaticResource MicroLabel}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Focusable="True" x:Name="KeyCaptureSurface"
                    PreviewKeyDown="KeyCaptureSurface_PreviewKeyDown" PreviewKeyUp="KeyCaptureSurface_PreviewKeyUp"
                    MouseDown="KeyCaptureSurface_MouseDown">
                <StackPanel>
                    <TextBlock Text="Click here, then press each key" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="38" Margin="1.5" CornerRadius="5"
                                                    Background="{Binding Background}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                    ToolTip="{Binding Note}">
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="10.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Grey keys are not deliverable to desktop applications: Fn combinations are resolved by firmware, the Secure Attention Sequence is reserved by Windows, and media/volume keys are consumed by the system audio session." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
