<UserControl x:Class="Merqo.Vertexa.App.Views.AudioLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Playback tests" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Tones are generated locally at the requested frequency. No internet connection, no codec pack and no paid service is involved." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Frequency (Hz):" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                        <Button Content="Left channel" Style="{StaticResource SecondaryButton}" Command="{Binding PlayLeftCommand}" Margin="0,0,8,0" />
                        <Button Content="Right channel" Style="{StaticResource SecondaryButton}" Command="{Binding PlayRightCommand}" Margin="0,0,8,0" />
                        <Button Content="Stereo" Style="{StaticResource SecondaryButton}" Command="{Binding PlayStereoCommand}" Margin="0,0,8,0" />
                        <Button Content="Mono" Style="{StaticResource SecondaryButton}" Command="{Binding PlayMonoCommand}" Margin="0,0,8,0" />
                        <Button Content="Sweep 200–4000 Hz" Style="{StaticResource SecondaryButton}" Command="{Binding PlaySweepCommand}" Margin="0,0,8,0" />
                        <Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Microphone" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="Recording starts only when you press Record, lasts three seconds, stays in memory, and is discarded when you leave this page. Nothing is uploaded." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Record 3 s" Style="{StaticResource PrimaryButton}" Command="{Binding RecordCommand}" Margin="0,0,8,0" />
                        <Button Content="Stop" Style="{StaticResource SecondaryButton}" Command="{Binding StopRecordingCommand}" Margin="0,0,8,0" />
                        <Button Content="Play recording" Style="{StaticResource SecondaryButton}" Command="{Binding PlayRecordingCommand}" Margin="0,0,8,0" />
                        <Button Content="Discard" Style="{StaticResource DangerButton}" Command="{Binding DiscardCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Analysis}" Style="{StaticResource MonoValue}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MicroLabel}" Margin="0,6,0,0" Text="Distortion, rattle and channel balance are subjective judgements: VERTEXA reports measurements and leaves the listening verdict to you." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Enumerated audio endpoints" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Devices}" Style="{StaticResource MetricGrid}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
