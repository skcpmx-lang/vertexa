<UserControl x:Class="Merqo.Vertexa.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,18,22,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Report type" Style="{StaticResource H2}" />
                        <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Height="230"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MicroLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Format" Style="{StaticResource MicroLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="Export folder" Style="{StaticResource MicroLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Export" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                            <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recent runs" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource Caption}" />
                                        <TextBlock Style="{StaticResource MicroLabel}">
                                            <Run Text="{Binding Scope, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding HealthState, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RunId, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource H2}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8"
                           Text="HTML, JSON and CSV are rendered exactly as they will be written. PDF layout is produced by the in-house PDF writer on export." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" Background="{DynamicResource Surface0Brush}"
                             BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
