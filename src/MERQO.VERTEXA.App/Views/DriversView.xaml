<UserControl x:Class="Merqo.Vertexa.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Driver updates are never downloaded or installed by VERTEXA. Use the PC manufacturer's official support site or Windows Update." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Driver and device summary" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Style="{StaticResource MetricGrid}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Device tree" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="Problems only" IsChecked="{Binding ProblemsOnly}" Margin="0,0,16,0" />
                        <TextBox Width="280" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="filter by name, class or version" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Class}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource MonoValue}" FontSize="11.5" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
