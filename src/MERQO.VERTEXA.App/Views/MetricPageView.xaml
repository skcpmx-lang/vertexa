<UserControl x:Class="Merqo.Vertexa.App.Views.MetricPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Aggregate}" Style="{StaticResource Body}" />
                    <TextBlock Text="Each value shows the provider that produced it. A state label means no measurement exists — never zero."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Rows}" Style="{StaticResource MetricGrid}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
