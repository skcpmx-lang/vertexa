<UserControl x:Class="Merqo.Vertexa.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="160" />
                    </StackPanel>
                    <CheckBox Content="Reduced motion (disable non-essential animation)" IsChecked="{Binding ReducedMotion}" />
                    <CheckBox Content="Show advanced metrics" IsChecked="{Binding ShowAdvancedMetrics}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{StaticResource H2}" />
                    <CheckBox Content="Redact serial numbers and MAC addresses in reports (recommended)" IsChecked="{Binding RedactSerials}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="VERTEXA has no network code path: nothing about this machine leaves it." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Monitoring and safety" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="Live sample interval (ms):" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Text="{Binding MonitoringIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="Thermal abort ceiling (°C):" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Text="{Binding ThermalAbortCelsius, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="Default stress duration (s):" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Text="{Binding DefaultStressDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="Default storage test size (MB):" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="90" Text="{Binding DefaultStorageTestSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Content="Keep live monitoring running in the background" IsChecked="{Binding MonitoringAutoStart}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Reports and history" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="Default format:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding DefaultExportFormat}" Width="140" Margin="0,0,16,0" />
                        <TextBlock Text="History limit:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="80" Text="{Binding HistoryLimit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBox Text="{Binding DefaultExportDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <CheckBox Content="Keep diagnostic history on this machine" IsChecked="{Binding KeepDiagnosticHistory}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open data folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Open log folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Delete diagnostic history" Style="{StaticResource DangerButton}" Command="{Binding DeleteHistoryCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataPath}" Style="{StaticResource MicroLabel}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Permissions" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding ElevationHint}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                        <Button Content="Reset to defaults" Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Warnings}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
