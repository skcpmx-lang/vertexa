<UserControl x:Class="Merqo.Vertexa.App.Views.DisplayLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="How this works" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="The lab shows calibrated full-screen patterns with no overlay. Sub-pixel faults, backlight bleed, tint and banding can only be judged by a human eye, so VERTEXA records your findings instead of pretending to detect pixels automatically." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Shortcuts in the pattern window: → next · ← previous · Space pause on the current pattern · Esc exit." />
                    <Button Content="Start full-screen inspection" Style="{StaticResource PrimaryButton}" Click="StartInspection_Click"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Patterns" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Patterns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Purpose}" Style="{StaticResource Caption}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Your findings" Style="{StaticResource H2}" />
                    <TextBlock Text="Write what you observe (dead pixels, bleed corners, tint). This text stays local; copy it into a report if you need to."
                               Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <TextBox AcceptsReturn="True" Height="140" TextWrapping="Wrap"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Detected displays" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Displays}" Style="{StaticResource MetricGrid}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
