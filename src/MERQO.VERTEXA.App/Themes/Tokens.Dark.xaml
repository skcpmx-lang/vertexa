<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MERQO VERTEXA design tokens — premium dark theme.
         Every colour token has a semantic name; views never hard-code a colour. -->
    <Color x:Key="Surface0Color">#0B0F14</Color>
    <Color x:Key="Surface1Color">#111823</Color>
    <Color x:Key="Surface2Color">#18212E</Color>
    <Color x:Key="Surface3Color">#202B3A</Color>
    <Color x:Key="StrokeColor">#26323F</Color>
    <Color x:Key="StrokeStrongColor">#33455A</Color>
    <Color x:Key="TextPrimaryColor">#E8EEF6</Color>
    <Color x:Key="TextSecondaryColor">#9FB0C3</Color>
    <Color x:Key="TextTertiaryColor">#6B7C8F</Color>
    <Color x:Key="AccentColor">#2FD4E8</Color>
    <Color x:Key="AccentDeepColor">#1B8FA3</Color>
    <Color x:Key="InfoColor">#4FA8FF</Color>
    <Color x:Key="SuccessColor">#37D67A</Color>
    <Color x:Key="WarningColor">#F5B042</Color>
    <Color x:Key="CriticalColor">#FF5D5D</Color>
    <Color x:Key="UnknownColor">#7A8AA0</Color>

    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource UnknownColor}" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="{StaticResource AccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC05090D" />
</ResourceDictionary>
